{
  "prettier.printWidth": 180,
  "editor.wordWrap": "on",
  "prettier.proseWrap": "never",
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "emmet.triggerExpansionOnTab": true,
  "editor.padding.top": 20,
  "editor.padding.bottom": 20,
  "editor.lineNumbers": "on",
  "editor.glyphMargin": true,
  "editor.folding": true,
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "monokaiPro.fileIconsMonochrome": true,
  "workbench.colorTheme": "Monokai Pro (Filter Machine)",
  "editor.tokenColorCustomizations": {
    "[*Monokai Pro*]": {
      "textMateRules": [
        {
          "name": "Force Pink Tags Desktop",
          "scope": [
            "entity.name.tag",
            "entity.name.tag",
            "entity.name.tag.script",
            "entity.name.tag.structure.any",
            "entity.name.tag.block.any",
            "entity.name.tag.inline.any",
            "meta.tag.any",
            "punctuation.definition.tag"
          ],
          "settings": {
            "foreground": "#FF69B4",
            "fontStyle": ""
          }
        }
      ]
    }
  },
  "cSpell.words": [
    "eswatini",
    "ghazal",
    "GSGX",
    "guineabissau",
    "Himyar",
    "Houthi",
    "latlng",
    "marginalised",
    "nicedropdown",
    "pathing",
    "Rasulid",
    "Rasulids",
    "Sabaean",
    "sahrawi",
    "Taiz",
    "Untransmittable"
  ],
  "cSpell.enabledLanguageIds": ["html", "markdown", "plaintext", "css", "javascript"],
  "cSpell.ignoreRegExpList": ["class=\"[^\"]*\"", "href=\"[^\"]*\"", "src=\"[^\"]*\""],
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "[markdown]": {
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  }
}

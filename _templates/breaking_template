    <!-- Audio Playback Script -->
    <script>
      document.addEventListener("click", function (e) {
        const btn = e.target.closest(".play-news-btn");
        if (!btn) return;
        const synth = window.speechSynthesis;
        const card = btn.closest(".news-content-expanded");
        const textToRead = card.querySelector(".news-text").innerText;
        const buttonText = btn.querySelector(".button-text");
        const playIcon = btn.querySelector(".play-icon");

        if (synth.speaking) {
          synth.cancel();
          buttonText.innerText = "Listen to Article";
          playIcon.innerText = "▶";
          return;
        }
        const utterance = new SpeechSynthesisUtterance(textToRead);
        utterance.rate = 0.9;
        utterance.pitch = 1.0;
        utterance.onstart = () => {
          playIcon.innerText = "⏹";
        };
        utterance.onend = () => {
          buttonText.innerText = "Listen to Article";
          playIcon.innerText = "▶";
        };
        synth.speak(utterance);
      });
    </script>


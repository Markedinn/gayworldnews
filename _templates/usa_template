          // If the user clicks the "white space" (not an interactive element)
          if (!interactiveTags.includes(e.target.tagName) && !e.target.closest(".resource-card")) {
            const parentDetails = container.closest("details");

            if (parentDetails && parentDetails.open) {
              parentDetails.removeAttribute("open");

              // Optional: Smooth scroll back to the summary so the user isn't disoriented
              parentDetails.scrollIntoView({ behavior: "smooth", block: "nearest" });
            }
          }
        });
      });
    </script>
    <style>
      /* Webkit engines (Chrome, Safari, Edge, Mobile viewports) */
      div::-webkit-scrollbar {
        height: 6px;
      }
      div::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
      }
      div::-webkit-scrollbar-thumb {
        background: linear-gradient(90deg, #ff00ff, #ffbc00);
        border-radius: 10px;
      }
      /* Modern Cross-Browser Standard (Firefox) */
      div {
        scrollbar-color: #ff00ff rgba(255, 255, 255, 0.05);
        scrollbar-width: thin;
      }
    </style>
    <div id="zoom-overlay" class="image-zoom-overlay"></div>
  </body>
</html>

        default_language: "en",
        detect_browser_language: true,
        wrapper_selector: "#translator-anchor",
        type: "nicedropdown",
      };

      // This "forces" the text because the widget settings sometimes fail
      window.addEventListener("load", function () {
        setTimeout(function () {
          var select = document.querySelector("#translator-anchor select");
          if (select) {
            // Creates a new "Select Language" option at the very top
            var opt = document.createElement("option");
            opt.value = "";
            opt.innerHTML = "Translate";
            opt.selected = true;
            opt.disabled = true;
            select.insertBefore(opt, select.firstChild);
          }
        }, 1000); // Waits 1 second for the widget to finish loading
      });
    </script>
    <script src="https://cdn.gtranslate.net/widgets/latest/dropdown.js" defer></script>

    <script>
      function toggleMenu() {
        const menu = document.getElementById("sideMenu");
        menu.classList.toggle("open");
      }

      window.addEventListener("click", function (e) {
        const menu = document.getElementById("sideMenu");
        const menuToggle = document.querySelector(".menu-toggle");

        // Safety check: only proceed if menu exists and is currently open
        if (menu && menu.classList.contains("open")) {
          // If the click is NOT the menu AND NOT the toggle button, close it
          if (!menu.contains(e.target) && !menuToggle.contains(e.target)) {
            toggleMenu();
          }
        }
      });

      document.querySelectorAll(".news-content-expanded").forEach((container) => {
        container.addEventListener("click", (e) => {
          // Define tags that SHOULD NOT trigger a close (interactive elements)
          const interactiveTags = ["A", "BUTTON", "IMG", "IFRAME", "TABLE", "TH", "TD", "SPAN"];

          // If the user clicks the "white space" (not an interactive element)
          if (!interactiveTags.includes(e.target.tagName) && !e.target.closest(".resource-card")) {
            const parentDetails = container.closest("details");

            if (parentDetails && parentDetails.open) {
              parentDetails.removeAttribute("open");

              // Optional: Smooth scroll back to the summary so the user isn't disoriented
              parentDetails.scrollIntoView({ behavior: "smooth", block: "nearest" });
            }
          }
        });
      });
    </script>

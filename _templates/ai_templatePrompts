    <script>
      function toggleMenu() {
        const menu = document.getElementById("sideMenu");
        menu.classList.toggle("open");
      }

      window.addEventListener("click", function (e) {
        const menu = document.getElementById("sideMenu");
        const menuToggle = document.querySelector(".menu-toggle");

        // Safety check: only proceed if menu exists and is currently open
        if (menu && menu.classList.contains("open")) {
          // If the click is NOT the menu AND NOT the toggle button, close it
          if (!menu.contains(e.target) && !menuToggle.contains(e.target)) {
            toggleMenu();
          }
        }
      });

      document.addEventListener("DOMContentLoaded", function () {
        const now = new Date();
        const options = { year: "numeric", month: "long", day: "numeric" };
        const dateString = now.toLocaleDateString("en-US", options);

        // Target the mobile ID
        const mobileEl = document.getElementById("last-updated-mobile");
        if (mobileEl) mobileEl.textContent = dateString;

        // Target the desktop ID
        const desktopEl = document.getElementById("last-updated-desktop");
        if (desktopEl) desktopEl.textContent = dateString;
      });

      document.querySelectorAll(".news-content-expanded").forEach((container) => {
        container.addEventListener("click", (e) => {
          // Define tags that SHOULD NOT trigger a close (interactive elements)
          const interactiveTags = ["A", "BUTTON", "IMG", "IFRAME", "TABLE", "TH", "TD", "SPAN"];

          // If the user clicks the "white space" (not an interactive element)
          if (!interactiveTags.includes(e.target.tagName) && !e.target.closest(".resource-card")) {
